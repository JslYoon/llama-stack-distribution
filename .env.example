# Llama Stack 0.5.0 Environment Variables
# Copy this file to .env and update with your values

# ===== STORAGE CONFIGURATION =====
# SQLite is used by default (no external database required)
# All databases are stored in /tmp and /rag-content directories

# ===== INFERENCE PROVIDERS (OPTIONAL - ENABLE AS NEEDED) =====

# vLLM Inference Provider
ENABLE_VLLM=true
VLLM_URL=https://meta-llama-31-8b-3scale-apicast-production.apps.rosa.redhat-ai-dev.m6no.p3.openshiftapps.com/v1
VLLM_API_KEY=6927381321080228e677dbda1ca4adcf
VLLM_MAX_TOKENS=4096
VLLM_TLS_VERIFY=true

# Ollama Inference Provider
# ENABLE_OLLAMA=1
# OLLAMA_URL=http://localhost:11434

# OpenAI Inference Provider
# ENABLE_OPENAI=1
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Vertex AI Inference Provider
# ENABLE_VERTEX_AI=1
# VERTEX_AI_PROJECT=your-project-id
# VERTEX_AI_LOCATION=us-central1

# ===== EMBEDDING PROVIDERS =====

# Sentence Transformers (for local embeddings)
ENABLE_SENTENCE_TRANSFORMERS=1

# ===== SAFETY CONFIGURATION =====

# Safety Model Endpoint (vLLM/Ollama serving llama-guard)
SAFETY_URL=
SAFETY_API_KEY=
SAFETY_MODEL=

# ===== VALIDATION SHIELD CONFIGURATION (OPTIONAL) =====

# Enable custom validation shield (e.g., for question validation)
# Uncomment to enable:
# ENABLE_VALIDATION_SHIELD=1

# Validation Model Endpoint (vLLM serving validation model)
# VALIDATION_URL=http://host.docker.internal:11434/v1
# VALIDATION_API_KEY=token
# VALIDATION_MODEL_NAME=redhataillama-31-8b-instruct

# ===== VECTOR I/O PROVIDERS =====

# FAISS is enabled by default in config.yaml
# No environment variables needed for inline FAISS

# ===== CONTAINER CONFIGURATION =====

# Path to llama-stack configuration file
RUN_CONFIG_PATH=/opt/app-root/config.yaml

# Server port
SERVER_PORT=8321

RAG_CONTENT_PATH=./rag-content


ENABLE_VLLM=true
VLLM_URL=
VLLM_API_KEY=
VLLM_MAX_TOKENS=4096
VLLM_TLS_VERIFY=true

